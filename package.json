{
  "name": "payload-site-starter",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:fast": "cross-env DISABLE_PAYLOAD_HMR=true NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:mcp": "cross-env PAYLOAD_ENABLE_MCP=true NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:webpack": "cross-env NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache NODE_OPTIONS=--no-deprecation next dev --webpack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "mailer:eos": "tsx scripts/eos-idml-mailer.ts",
    "postdeploy:sitemaps": "node ./scripts/trigger-sitemap-rebuild.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@lexical/selection": "0.41.0",
    "@payloadcms/db-mongodb": "3.79.1",
    "@payloadcms/email-resend": "3.79.1",
    "@payloadcms/live-preview-react": "3.79.1",
    "@payloadcms/next": "3.79.1",
    "@payloadcms/payload-cloud": "3.79.1",
    "@payloadcms/plugin-form-builder": "3.79.1",
    "@payloadcms/plugin-mcp": "3.79.1",
    "@payloadcms/plugin-multi-tenant": "3.79.1",
    "@payloadcms/plugin-nested-docs": "3.79.1",
    "@payloadcms/plugin-redirects": "3.79.1",
    "@payloadcms/plugin-search": "3.79.1",
    "@payloadcms/plugin-seo": "3.79.1",
    "@payloadcms/richtext-lexical": "3.79.1",
    "@payloadcms/storage-s3": "3.79.1",
    "@payloadcms/ui": "3.79.1",
    "@puckeditor/core": "0.21.2",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-email/components": "1.0.12",
    "@react-email/markdown": "0.0.18",
    "@react-email/render": "2.0.7",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "geist": "^1.4.2",
    "graphql": "^16.11.0",
    "jszip": "^3.10.1",
    "konva": "^10.2.5",
    "lexical": "0.41.0",
    "lucide-react": "^0.477.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "openai": "^5.12.2",
    "payload": "3.79.1",
    "payload-admin-bar": "^1.0.7",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.54.2",
    "react-konva": "^19.2.3",
    "react-select": "^5.10.2",
    "react-wrap-balancer": "^1.1.1",
    "render-tag": "^0.1.3",
    "sharp": "0.34.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@tailwindcss/typography": "^0.5.16",
    "@types/escape-html": "^1.0.4",
    "@types/node": "22.5.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "^2.4.1",
    "dotenv": "^16.4.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.2.6",
    "fast-xml-parser": "^4.4.1",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
