# MongoDB connection URI
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/<db>?retryWrites=true&w=majority

# Application Secrets
PAYLOAD_SECRET=your_secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
CRON_SECRET=your_cron_secret
SITEMAP_REBUILD_SECRET=your_sitemap_rebuild_secret
PREVIEW_SECRET=your_preview_secret
ELASTIC_EMAIL_WEBHOOK_SECRET=your_long_random_elastic_webhook_secret
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000
PAYLOAD_PREVIEW_JWT=your_preview_jwt
PAYLOAD_ENABLE_MCP=false
PAYLOAD_MCP_PUBLIC_SECRET=your_long_random_secret_for_mcp_public_path
PAYLOAD_MCP_PROXY_TARGET_ORIGIN=https://admin.yourdomain.com

# R2 Storage Configuration
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_ENDPOINT=your_r2_endpoint

# Resend Email Configuration
RESEND_API_KEY=pk_your_resend_key
RESEND_FROM_EMAIL=info@yourdomain.com
RESEND_FROM_NAME=Your Site Name

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
SITEMAP_REBUILD_BASE_URL=http://localhost:3000
SITEMAP_REBUILD_RETRIES=8
SITEMAP_REBUILD_RETRY_DELAY_MS=5000
SITEMAP_REBUILD_TIMEOUT_MS=30000
AUTO_BOOTSTRAP_SITEMAPS=false
DISABLE_SITEMAP_BOOTSTRAP=false
